# Copy to /home/user/docker/knsmartfritz/smartfritz.env on m1 and chmod 600 it.
# An address, not a name: the lights must not depend on DNS, and fritz.box is a public name.
SMARTFRITZ_FRITZ_URL=https://192.168.178.1
SMARTFRITZ_FRITZ_USER=smart-user
# Keep the single quotes: compose would otherwise expand any $ in a password.
SMARTFRITZ_FRITZ_PASSWORD=''
# The password of the web page. Pick a long one.
SMARTFRITZ_APP_PASSWORD=''
# Follow the box when it makes itself a new certificate, instead of stopping.
SMARTFRITZ_FRITZ_CERT_AUTO=1
TZ=Europe/Berlin
